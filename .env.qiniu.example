# Copy this file to .env.qiniu and fill in your Qiniu credentials.
# Get AK/SK from: https://portal.qiniu.com/developer/user/key

QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=

# Optional. Upload into a folder inside the bucket, e.g. site/
# Leave empty to upload to bucket root.
QINIU_KEY_PREFIX=

# Optional. Bound CDN / custom domain, without trailing slash.
# Example: https://www.chenyomi.top
# If set, the script will refresh the homepage after upload.
QINIU_CDN_DOMAIN=
